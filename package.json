{
  "name": "@proxies-sx/mcp-server",
  "version": "3.0.1",
  "description": "MCP server for residential and mobile proxies: AI agents get rotating and sticky proxy URLs (HTTP/SOCKS5), live stock per country, IP rotation, usage and billing. Proxies.sx Pool Gateway, metered per GB.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "proxies-sx-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts",
    "check:sync": "node scripts/check-sync.cjs",
    "build:manifest": "node scripts/build-manifest.cjs",
    "prepublishOnly": "npm run build && npm run build:manifest && npm run check:sync"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "residential-proxy",
    "mobile-proxy",
    "rotating-proxy",
    "proxy",
    "proxies",
    "socks5",
    "http-proxy",
    "web-scraping",
    "ip-rotation",
    "4g-proxy",
    "ai-agent",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor",
    "anthropic",
    "x402",
    "pool-gateway",
    "proxy-management"
  ],
  "author": "Proxies.sx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bolivian-peru/proxies-sx-mcp-server.git"
  },
  "homepage": "https://agents.proxies.sx/mcp/",
  "bugs": {
    "url": "https://github.com/bolivian-peru/proxies-sx-mcp-server/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^2.43.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llm.txt",
    "SKILL.md",
    "server.json",
    "tools.json"
  ],
  "mcpName": "io.github.bolivian-peru/proxies-sx-mcp-server"
}
